    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controllers\ClientsController.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Controllers\ClientsController.cs" />
